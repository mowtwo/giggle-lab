{
  "name": "giggle-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.26.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.2.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/copy-ffmpeg-core.mjs && next dev",
    "build": "pnpm build:adou:rebuilt && pnpm copy:ffmpeg && pnpm build:next",
    "copy:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "build:next": "next build",
    "build:adou": "node scripts/build-adou.mjs",
    "build:adou:rebuilt": "ADOU_MODE=rebuilt node scripts/build-adou.mjs",
    "build:adou:original": "node scripts/sync-adou-original.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:adou": "tsc --noEmit -p apps/adou-laya/tsconfig.json",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm knip",
    "probe:determinism": "node apps/adou-laya/sim-probe/run.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:recorder": "node --experimental-strip-types scripts/test-recorder.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@fontsource/ma-shan-zheng": "^5.2.9",
    "@mediapipe/tasks-vision": "^0.10.35",
    "animal-island-ui": "1.0.16",
    "docx-preview": "^0.3.7",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "motion": "^12.39.0",
    "mpegts.js": "^1.8.2",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-zoom-pan-pinch": "^4.0.3",
    "three": "^0.184.0",
    "tone": "^15.1.22",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "knip": "^6.37.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
